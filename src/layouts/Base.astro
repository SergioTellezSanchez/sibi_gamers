---
import "../styles/index.css";
import TopNav from "../components/TopNav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/mark-amber.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#03071E" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sibi Gamers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    <div class="site">
      <TopNav />
      <main class="shell">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // One motion module for the whole site. Static markup opts in through
      // data-attributes, so nothing needs to be an island just to animate.
      import "../scripts/motion";
    </script>
  </body>
</html>
