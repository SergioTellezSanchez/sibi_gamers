---

<footer class="footer">
  <div class="footer__cols">
    <div class="footer__wordmark">SIBI GAMERS</div>
    {
      COLUMNS.map((col) => (
        <nav aria-label={col.title}>
          <div class="footer__col-title">{col.title}</div>
          {col.links.map((link) => (
            <a class="footer__link" href={link.href}>
              {link.label}
            </a>
          ))}
        </nav>
      ))
    }
  </div>

  <div class="footer__bottom">
    <div class="footer__legal">
      © 2026 Sibi Gamers. Sibi means fire in Jñatjo (Mazahua).
    </div>

    <ul class="footer__socials">
      {
        SOCIALS.map((social) => (
          <li>
            <a class="footer__social" href={social.href} aria-label={social.label}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d={social.path} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
