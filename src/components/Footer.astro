---
const COLUMNS = [
  {
    title: "Explore",
    links: [
      { label: "Rankings", href: "/" },
      { label: "Reviews", href: "/reviews/" },
      { label: "News", href: "/news/" },
      { label: "Guides", href: "/guides/" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/" },
      { label: "Contact", href: "/" },
      { label: "Press", href: "/" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Terms", href: "/" },
      { label: "Privacy", href: "/" },
      { label: "How we score", href: "/" },
    ],
  },
];

// Inline so the footer never reaches for an icon font or external sprite.
