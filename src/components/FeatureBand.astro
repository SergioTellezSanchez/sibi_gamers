---
// Differentiator from master doc §2: downloadable high-quality art is a
// headline feature, not an accessory.
---

<section class="band" data-reveal data-reveal-stagger="0.05">
  <span class="band__layer band__layer--back"></span>
  <span class="band__layer band__layer--mid"></span>

  <div class="band__face" data-reveal-item>
    <div>
      <h2 class="band__title">Download all game art and screenshots in high quality</h2>
      <p class="band__copy">
        Cover art, key art, and screenshots for every ranked title, ready for press or
        personal use.
      </p>
    </div>
    <button type="button" class="btn btn--primary btn--md">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      Download assets
    </button>
  </div>
</section>
